<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
    <!-- The target frameworks share one client build, so build them one at a time -->
    <BuildInParallel>false</BuildInParallel>
  </PropertyGroup>

  <!-- One target framework per Umbraco .NET version. Code that differs between them uses #if NET9_0_OR_GREATER etc. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Umbraco.Cms.Infrastructure" Version="[14.0.0, 15.0.0)" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Umbraco.Cms.Infrastructure" Version="[15.0.0, 17.0.0)" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Umbraco.Cms.Infrastructure" Version="[17.0.0, 19.0.0)" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <PackageReference Include="Umbraco.Cms.Infrastructure" Version="[19.0.0-beta1, 20.0.0)" />
  </ItemGroup>

  <PropertyGroup>
    <PackageId>Umbraco.Community.Meganav</PackageId>
    <Product>Umbraco.Community.Meganav</Product>
    <Title>Meganav</Title>
    <Description>A flexible, draggable link picker for constructing site navigation menus, big or small, in Umbraco.</Description>
    <PackageTags>umbraco;umbraco-marketplace;navigation;menu;links</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ClientAssetsInputs Include="Client\src\**;Client\public\**" />
    <!-- Don't include the client source when packing -->
    <Content Remove="Client\**" />
    <None Include="Client\public\umbraco-package.json" Pack="false" />
  </ItemGroup>

  <!-- Restore and build client files -->
  <Target Name="RestoreClient" Inputs="Client\package.json;Client\package-lock.json" Outputs="Client\node_modules\.package-lock.json">
    <Message Importance="high" Text="Restoring Meganav client NPM packages..." />
    <Exec Command="npm i" WorkingDirectory="Client" />
  </Target>

  <Target Name="BuildClient" BeforeTargets="AssignTargetPaths" DependsOnTargets="RestoreClient" Inputs="@(ClientAssetsInputs)" Outputs="$(BaseIntermediateOutputPath)client.complete.txt">
    <Message Importance="high" Text="Building Meganav client..." />
    <Exec Command="npm run build" WorkingDirectory="Client" />
    <ItemGroup>
      <_ClientAssetsBuildOutput Include="wwwroot\App_Plugins\**" />
    </ItemGroup>
    <WriteLinesToFile File="$(BaseIntermediateOutputPath)client.complete.txt" Lines="@(_ClientAssetsBuildOutput)" Overwrite="true" />
  </Target>
</Project>
